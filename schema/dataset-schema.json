{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://h-cel.github.io/hpc-docs/schema/dataset-schema.json",
  "title": "Dataset metadata",
  "description": "Schema for the metadata.yaml that must sit alongside every dataset folder under $VSC_DATA_VO/shared/.",
  "type": "object",
  "required": ["dataset", "source", "coverage", "variables", "contact", "history"],
  "additionalProperties": false,
  "properties": {
    "storage": {
      "type": "object",
      "description": "Storage information"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about the dataset"
    },
    "related_datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "path": {"type": "string"},
          "note": {"type": "string"}
        }
      },
      "description": "Related datasets with names, paths, and optional notes"
    },
    "dataset": {
      "type": "object",
      "required": ["name", "long_name", "description"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "long_name": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "required": ["provider", "url", "license"],
      "additionalProperties": false,
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "doi": {"type": "string"},
        "license": {"type": "string", "minLength": 1},
        "citation": {"type": "string", "description": "Preferred citation format"}
      }
    },
    "coverage": {
      "type": "object",
      "required": ["spatial", "temporal"],
      "additionalProperties": false,
      "properties": {
        "spatial": {
          "type": "object",
          "required": ["domain", "resolution"],
          "additionalProperties": false,
          "properties": {
            "domain": {"type": "string", "minLength": 1},
            "resolution": {"type": "string", "minLength": 1}
          }
        },
        "temporal": {
          "type": "object",
          "required": ["start", "end", "frequency"],
          "additionalProperties": false,
          "properties": {
            "start": {"type": "string"},
            "end": {"type": "string"},
            "frequency": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["short_name", "standard_name", "units"],
        "additionalProperties": false,
        "properties": {
          "short_name": {"type": "string", "minLength": 1},
          "standard_name": {"type": "string", "minLength": 1},
          "units": {"type": "string"},
          "description": {"type": "string", "description": "Human-readable description of the variable"}
        }
      }
    },
    "contact": {
      "type": "object",
      "required": ["name", "email", "vsc_username"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "email": {"type": "string", "format": "email"},
        "vsc_username": {"type": "string", "pattern": "^vsc[0-9]+$"}
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "description"],
        "additionalProperties": false,
        "properties": {
          "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "description": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1, "description": "Link to script or commit that performed this operation"}
        }
      }
    }
  }
}
